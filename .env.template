# HandyTech Solutions - Environment Variables Template for VPS Deployment
# Copy this file to .env on your VPS and replace all placeholder values with your actual secrets

# Database Configuration (REQUIRED)
# For VPS deployment, use format: postgresql://handy:password@localhost:5432/handydb
DATABASE_URL=postgresql://username:password@hostname:port/database

# Security Configuration (REQUIRED)
SESSION_SECRET=your-session-secret-minimum-32-characters-long
JWT_SECRET=your-jwt-secret-minimum-32-characters-long

# Admin Authentication (REQUIRED)
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-secure-admin-password

# Email Configuration (REQUIRED)
ADMIN_EMAIL=contact@handytech-solutions.com
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_USER=contact@handytech-solutions.com
SMTP_PASS=your-email-password
FROM_EMAIL=contact@handytech-solutions.com

# Google Calendar Integration (OPTIONAL - Comment out if not using)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/admin/google/callback
GOOGLE_CALENDAR_ID=primary

# AI Services (OPTIONAL - Comment out if not using)
OPENAI_API_KEY=sk-your-openai-api-key

# Email Automation (OPTIONAL - Comment out if not using)
BREVO_API_KEY=your-brevo-sendinblue-api-key

# Twilio SMS Configuration (OPTIONAL - Comment out if not using)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+15551234567
ADMIN_SMS_TO=+15557654321

# Cross-Origin and Security Configuration (OPTIONAL)
ALLOWED_ORIGINS=https://your-domain.com,https://your-replit-url.replit.app
CSRF_SAME_SITE=lax

# Application Configuration
NODE_ENV=production
PORT=5000
TZ=America/Chicago

# IMPORTANT INSTRUCTIONS:
# 1. Copy this file to .env on your VPS: cp .env.template .env
# 2. Replace ALL placeholder values with your actual secrets
# 3. Make sure .env file has proper permissions: chmod 600 .env
# 4. Never commit .env file to version control
# 5. Generate strong secrets for SESSION_SECRET and JWT_SECRET (32+ characters)