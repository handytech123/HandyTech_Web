{
  "manifest_version": 3,
  "name": "HandyTech Home Depot Connector",
  "version": "1.0.3",
  "description": "Securely imports visible Pro Referral leads into HandyTech Solutions.",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://proreferral.homedepot.com/*",
    "https://www.proreferral.com/*",
    "https://handytech-solutions.com/*"
  ],
  "content_scripts": [{
    "matches": ["https://proreferral.homedepot.com/*", "https://www.proreferral.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "options_page": "options.html",
  "action": { "default_title": "HandyTech Home Depot Connector" }
}
