{
  "appName": "HandyTech Solutions",
  "version": "1.0.0",
  "description": "Handyman Services Platform with CRM, scheduling, and customer management",
  "type": "nodejs",
  "deploymentType": "dynamic",
  "architecture": "full-stack",
  "siteType": "web-application",
  "requiresServer": true,
  "buildCommand": "npm run build",
  "startCommand": "npm start",
  "port": 5000,
  "requiredServices": ["nodejs", "npm", "nginx", "postgresql"],
  "environmentVariables": ["NODE_ENV", "PORT", "DATABASE_URL", "SESSION_SECRET"],
  "requiredSecrets": [
    {
      "key": "DATABASE_URL",
      "description": "PostgreSQL database connection string",
      "required": true,
      "category": "database",
      "example": "postgresql://username:password@hostname:port/database"
    },
    {
      "key": "ADMIN_USERNAME", 
      "description": "Admin portal login username",
      "required": true,
      "category": "authentication",
      "example": "admin"
    },
    {
      "key": "ADMIN_PASSWORD",
      "description": "Admin portal login password", 
      "required": true,
      "category": "authentication",
      "example": "secure_password_here"
    },
    {
      "key": "OPENAI_API_KEY",
      "description": "OpenAI API key for chatbot functionality (optional - has fallback system)",
      "required": false,
      "category": "ai_services",
      "example": "sk-..."
    },
    {
      "key": "BREVO_API_KEY",
      "description": "Brevo API key for automated appointment reminder emails",
      "required": true,
      "category": "email_services",
      "example": "xkeysib-..."
    }
  ],
  "optionalSecrets": [
    {
      "key": "SESSION_SECRET",
      "description": "Secret key for session encryption",
      "required": false,
      "category": "security",
      "example": "random_string_for_session_encryption"
    }
  ],
  "framework": "express_vite",
  "frontend": "react",
  "database": "postgresql",
  "buildOutput": "dist/",
  "staticFiles": "dist/public/",
  "packageManager": "npm",
  "nodeVersion": "20",
  "features": [
    "Customer Management",
    "Calendly Integration - 3 Time Blocks (2h/4h/6h)", 
    "Quote Management",
    "Project Gallery",
    "Admin Dashboard",
    "AI Chatbot with OpenAI GPT-5",
    "Brevo Email Automation",
    "Review System",
    "Webhook Integration",
    "ssr",
    "api",
    "database",
    "sessions",
    "static-assets"
  ],
  "dependencies": {
    "production": true,
    "devDependencies": false
  },
  "healthCheck": {
    "path": "/api/health",
    "timeout": 30
  },
  "webhooks": {
    "description": "Webhook endpoints for external service integrations",
    "endpoints": {
      "calendly": {
        "url": "/api/webhooks/calendly",
        "method": "POST",
        "description": "Calendly webhook endpoint for appointment booking notifications",
        "purpose": "Receives Calendly invitee.created events and creates appointments in HandyTech database with Brevo email confirmations"
      }
    }
  },
  "integrations": {
    "calendly": {
      "name": "Calendly Appointment Scheduling",
      "description": "Professional appointment scheduling with 2h/4h/6h time blocks",
      "webhook_url": "https://{{domain}}/api/webhooks/calendly",
      "features": ["appointment_scheduling", "email_confirmations", "customer_creation"]
    },
    "brevo": {
      "name": "Brevo Email Automation",
      "description": "Automated appointment confirmations and reminder emails",
      "features": ["appointment_confirmations", "reminder_emails", "customer_communications"]
    },
    "openai": {
      "name": "AI Customer Service Chatbot",
      "description": "Intelligent customer service with fallback system",
      "features": ["customer_support", "appointment_assistance", "service_information"]
    }
  },
  "ssl": true,
  "domain": "handytech-solutions.com"
}