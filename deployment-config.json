{
  "appName": "HandyTech Solutions",
  "version": "1.0.0",
  "description": "Handyman Services Platform with CRM, scheduling, and customer management",
  "requiredSecrets": [
    {
      "key": "DATABASE_URL",
      "description": "PostgreSQL database connection string",
      "required": true,
      "category": "database",
      "example": "postgresql://username:password@hostname:port/database"
    },
    {
      "key": "ADMIN_USERNAME", 
      "description": "Admin portal login username",
      "required": true,
      "category": "authentication",
      "example": "admin"
    },
    {
      "key": "ADMIN_PASSWORD",
      "description": "Admin portal login password", 
      "required": true,
      "category": "authentication",
      "example": "secure_password_here"
    },
    {
      "key": "OPENAI_API_KEY",
      "description": "OpenAI API key for chatbot functionality (optional - has fallback system)",
      "required": false,
      "category": "ai_services",
      "example": "sk-..."
    }
  ],
  "optionalSecrets": [
    {
      "key": "SESSION_SECRET",
      "description": "Secret key for session encryption",
      "required": false,
      "category": "security",
      "example": "random_string_for_session_encryption"
    }
  ],
  "deployment": {
    "type": "nodejs",
    "port": 5000,
    "buildCommand": "npm run build",
    "startCommand": "npm run dev",
    "framework": "express_vite"
  },
  "features": [
    "Customer Management",
    "Appointment Scheduling", 
    "Quote Management",
    "Project Gallery",
    "Admin Dashboard",
    "AI Chatbot",
    "Email Automation",
    "Review System"
  ],
  "dependencies": {
    "database": "PostgreSQL",
    "frontend": "React + TypeScript + Vite",
    "backend": "Express.js",
    "ui": "Shadcn/UI + Tailwind CSS"
  }
}