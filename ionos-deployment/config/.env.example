# HandyTech Solutions - Environment Configuration
# Copy this file to /opt/handytech/.env and fill in your actual values

# =============================================================================
# REQUIRED ENVIRONMENT VARIABLES
# These MUST be set for the application to start successfully
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://username:password@hostname:port/database

# Security Configuration  
SESSION_SECRET=your-strong-random-session-secret-at-least-32-characters-long

# Admin Authentication
ADMIN_PASS=SecureAdminPassword123!

# Email Configuration - IONOS SMTP
ADMIN_EMAIL=contact@handytech-solutions.com
SMTP_HOST=smtp.ionos.com
SMTP_USER=contact@handytech-solutions.com
SMTP_PASS=your-email-password

# Google Calendar Integration
GOOGLE_CLIENT_ID=123456789-abc123def456.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-abc123def456789012345
GOOGLE_REDIRECT_URI=https://handytech-solutions.com/api/admin/google/callback

# =============================================================================
# OPTIONAL ENVIRONMENT VARIABLES  
# These have sensible defaults but can be customized
# =============================================================================

# Google Calendar Settings
GOOGLE_CALENDAR_ID=contact@handytech-solutions.com
TZ=America/Chicago

# AI Services
OPENAI_API_KEY=sk-proj-...

# Email Marketing (Optional)
BREVO_API_KEY=xkeysib-...

# Business Information
FROM_EMAIL=service@handytech-solutions.com
BUSINESS_NAME=HandyTech Solutions
BUSINESS_PHONE=(314) 325-4575
PUBLIC_BASE_URL=https://handytech-solutions.com

# SMTP Configuration
SMTP_PORT=587

# Security Configuration
ALLOWED_ORIGINS=https://handytech-solutions.com,https://www.handytech-solutions.com

# Legacy Configuration (deprecated but included for compatibility)
JWT_SECRET=your-strong-random-jwt-secret-at-least-32-characters-long
ADMIN_USERNAME=admin
JWT_EXPIRES_IN=24h

# =============================================================================
# SYSTEM ENVIRONMENT VARIABLES
# These are typically set by the deployment system
# =============================================================================

NODE_ENV=production
PORT=5000

# =============================================================================
# IONOS SPECIFIC CONFIGURATION NOTES
# =============================================================================

# SMTP Configuration for IONOS:
# - SMTP_HOST: Use smtp.ionos.com 
# - SMTP_PORT: Use 587 (STARTTLS) or 465 (SSL)
# - SMTP_USER: Your domain email address (e.g., contact@handytech-solutions.com)
# - SMTP_PASS: Your email account password

# Database Options:
# - Managed PostgreSQL: Use IONOS Database service connection string
# - Self-hosted: Use local PostgreSQL installed by setup scripts

# Domain Configuration:
# - Update GOOGLE_REDIRECT_URI with your actual domain
# - Update PUBLIC_BASE_URL with your domain
# - Update ALLOWED_ORIGINS with your domain(s)

# Security Notes:
# - SESSION_SECRET: Generate using: openssl rand -base64 48
# - JWT_SECRET: Generate using: openssl rand -base64 48  
# - Use strong passwords for ADMIN_PASS
# - Never commit this file with real values to version control